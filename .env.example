OPENAI_API_KEY=
TAVILY_API_KEY=
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_FORCE_CPU=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=300
# 기본 제공 함수. 다른 구현은 module:function 또는 절대경로/파일.py:function 설정
SKYTRACE_RELIABILITY_FUNCTION=analysis.reliability:run
SKYTRACE_RELIABILITY_INPUT_MODE=dict
SKYTRACE_RELIABILITY_TIMEOUT=30
# 배포 설정: 로컬에서는 아래 기본값 유지. 상세: docs/deployment.md
SKYTRACE_DEPLOYMENT=0
# 비워두지 말고 변경할 때만 지정 (절대 경로 권장): SKYTRACE_DATA_DIR=/data
SKYTRACE_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SKYTRACE_PUBLIC_ORIGINS=
SKYTRACE_ACCESS_USER=
SKYTRACE_ACCESS_PASSWORD=
OPENAI_MODEL=gpt-4.1-mini
SKYTRACE_MAX_DOCUMENTS=6
SKYTRACE_MAX_DOCUMENT_CHARS=10000
SKYTRACE_ALLOWED_DOMAINS=mod.go.jp,mofa.go.kr,mnd.go.kr,jcs.mil.kr,fmprc.gov.cn,motc.gov.tw,caa.gov.tw,jaxa.jp,reuters.com,apnews.com,news.cn
