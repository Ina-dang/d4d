{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "겹눈: 기본 실행 (기존 스토리보드)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8766", "--no-use-colors"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Uvicorn running on (http://127\\.0\\.0\\.1:8766)",
        "uriFormat": "%s/storyboard/storyboard.html?screen=scope"
      }
    },
    {
      "name": "겹눈: 기존 분석 앱",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8766", "--no-use-colors"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Uvicorn running on (http://127\\.0\\.0\\.1:8766)",
        "uriFormat": "%s/app"
      }
    }
  ]
}
