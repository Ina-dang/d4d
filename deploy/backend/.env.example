SKYTRACE_DEPLOYMENT=1
SKYTRACE_DATA_DIR=/data
SKYTRACE_ALLOWED_HOSTS=127.0.0.1,localhost,backend.example.com,example.vercel.app
SKYTRACE_PUBLIC_ORIGINS=https://example.vercel.app,https://backend.example.com
SKYTRACE_ACCESS_USER=team
# Set a unique password of at least 16 characters. Do not commit the real .env.
SKYTRACE_ACCESS_PASSWORD=
TAVILY_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT=300
SKYTRACE_RELIABILITY_FUNCTION=analysis.reliability:run
# Optional: only needed for the separate /app OpenAI analysis path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
