[Unit]
Description=Gyeopnun multilingual evidence report
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=gyeopnun
Group=gyeopnun
WorkingDirectory=/srv/gyeopnun/app
EnvironmentFile=/etc/gyeopnun/app.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/gyeopnun/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8766 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/gyeopnun/data

[Install]
WantedBy=multi-user.target
